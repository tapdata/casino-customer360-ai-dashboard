# AI provider: deepseek or openai. Cloud demo defaults to DeepSeek.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional local-only proxy (for example, a Shadowrocket HTTP proxy).
# When set, `npm run dev` starts a loopback-only relay; cloud deployments do not use it.
LOCAL_AI_PROXY=
LOCAL_AI_RELAY_PORT=8789

# TapData published API. Keep these server-side only.
TAPDATA_API_BASE_URL=http://127.0.0.1:3080
# MDM API now publishes as /api/v1/{mdm_api_table}/find.
TAPDATA_FIND_PATH_TEMPLATE=/api/v1/{collection}/find
# Optional logical-name -> published-service-name mapping. Use this when MDM API
# names differ from the AI panel's logical MongoDB collection names.
TAPDATA_COLLECTION_MAP={"alert_rules":"ops_alert_rules","campaign_runs":"marketing_campaign_runs","chat_messages":"ai_chat_messages_src","chat_sessions":"ai_chat_sessions_src","offer_approval_audit":"ai_offer_approval_audit_src","offer_recommendations":"ai_offer_recommendations_src","patron_activity_events":"patron_activity_events_ai_ready","patron_alerts":"ops_patron_alerts_ai_ready","patron_analysis_reports":"ai_patron_analysis_reports_src","patron_interaction_history":"patron_interaction_history_ai_ready","patron_realtime_decision_signals":"gaming_realtime_decision_signals_ai_ready","patron_risk_cases":"responsible_play_cases_ai_ready","pr_assignments":"host_assignments_ai_ready","table_minbet_audit":"gaming_table_minbet_audit","table_minbet_recommendations":"gaming_table_minbet_recommendations","table_round_counters":"gaming_table_round_counters","table_round_history":"gaming_player_round_bets","table_state_history":"gaming_table_state_history","table_state_snapshots":"gaming_table_state"}
# Prefer OAuth2 Client Credentials; a fixed access token remains available for local debugging.
TAPDATA_TOKEN_URL=
TAPDATA_CLIENT_ID=
TAPDATA_CLIENT_SECRET=
TAPDATA_TOKEN_AUTH_METHOD=client_secret_post
TAPDATA_ACCESS_TOKEN=
# Local safety net for published APIs that ignore the filter object. Keep this
# above the largest demo collection; use server-side filtering for large production datasets.
TAPDATA_SCAN_LIMIT=1000
# The panel serves the last complete snapshot immediately while refreshing
# TapData in the background. Values are milliseconds.
PATRONS_CACHE_FRESH_MS=7000

# AI panel action audit persistence. The database is created by MongoDB on first insert.
# Use either MONGO_AUDIT_URI or the host/user/password fields below.
MONGO_AUDIT_URI=
MONGO_AUDIT_HOST=<mongo-host>:27017
MONGO_AUDIT_USER=<mongo-user>
MONGO_AUDIT_PASSWORD=
MONGO_AUDIT_AUTH_DB=<auth-db>
MONGO_AUDIT_AUTH_MECHANISM=SCRAM-SHA-256
MONGO_AUDIT_DB=ai_loyalty_engine
MONGO_AUDIT_COLLECTION=ai_action_events
LOCAL_AUDIT_RELAY_PORT=8790
# npm run dev sets this automatically when Mongo audit variables are configured.
MONGO_AUDIT_HTTP_URL=http://127.0.0.1:8790
