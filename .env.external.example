# Copy to .env.external and keep the copy private. This profile does not start
# TapData; it connects to a colleague's existing Enterprise installation.
AI_PANEL_PORT=3000
AI_PANEL_PUBLIC_HOST=<server-ip-or-hostname>

# AI provider for the panel
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Published API consumed by the AI panel (usually the provider's 3080 port).
TAPDATA_API_BASE_URL=http://<tapdata-host>:3080
TAPDATA_FIND_PATH_TEMPLATE=/api/v1/{collection}/find
TAPDATA_TOKEN_URL=http://<tapdata-host>:3030/oauth/token
TAPDATA_CLIENT_ID=
TAPDATA_CLIENT_SECRET=
TAPDATA_ACCESS_TOKEN=
TAPDATA_TOKEN_AUTH_METHOD=client_secret_post
TAPDATA_COLLECTION_MAP=

# Manager API used by the importer (usually the provider's 3030 port).
TAPDATA_IMPORT_API_BASE_URL=http://<tapdata-host>:3030
TAPDATA_IMPORT_TOKEN=
TAPDATA_IMPORT_AUTHORIZATION=
TAPDATA_IMPORT_MODE=api
TAPDATA_IMPORT_POSTPROCESS=true
TAPDATA_IMPORT_AUTOSTART=true
TAPDATA_TASK_START_METHOD=PUT
TAPDATA_TASK_START_PATH_TEMPLATE=/api/Task/batchStart?taskIds={taskId}

# The provider's empty source MongoDB. TapData Enterprise supplies the MDM
# connection; the installer reuses the existing connection named MDM.
TAPDATA_IMPORT_SOURCE_MONGODB_URI=mongodb://<user>:<password>@<mongo-host>:27017/tapdata_casino_marketing?authSource=admin&replicaSet=rs1
TAPDATA_IMPORT_SOURCE_MONGODB_DB=tapdata_casino_marketing
TAPDATA_IMPORT_SOURCE_CONNECTION_NAME=MongoDB_Source
TAPDATA_IMPORT_TARGET_CONNECTION_NAME=MDM
TAPDATA_IMPORT_USE_EXISTING_TARGET=true

# Restore the anonymized 23-collection demo seed into the empty Source database.
# Set false when the provider has already restored it.
TAPDATA_IMPORT_RESTORE_SOURCE=true
TAPDATA_IMPORT_VERIFY_MDM_DATA=true
TAPDATA_IMPORT_ALLOW_PARTIAL_API=false
TAPDATA_IMPORT_MDM_WAIT_ATTEMPTS=60
TAPDATA_IMPORT_MDM_WAIT_INTERVAL_MS=5000

# Separate database for panel audit/snapshots; may use the same Mongo server.
MONGO_AUDIT_URI=mongodb://<user>:<password>@<mongo-host>:27017/marketing_demo?authSource=admin&replicaSet=rs1
MONGO_AUDIT_DB=marketing_demo
MONGO_SNAPSHOT_DB=marketing_demo

# Existing source-only generator runs automatically under systemd.
FEEDER_ENABLED=true
FEEDER_INTERVAL_MS=15000
FEEDER_SESSION_UPDATES_PER_TICK=1
FEEDER_BET_INCREMENT=500

# Anonymized demo data and sanitized task/API templates are included in git.
SOURCE_RESTORE_BACKUP_DIR=seed/demo
TAPDATA_IMPORT_ROOT=deploy/tapdata/templates
