# Copy to .env.demo before starting the local demo kit.
# This file contains placeholders only. Never commit .env.demo.

# Container images / exposed ports
# The one-command demo follows the official community image. Pin an exact
# version (for example v4.22.0-6a76ddc1 or your licensed v4.21 tag) when you
# need reproducible builds.
# Leave empty to use an existing external TapData service.
COMPOSE_PROFILES=bundled-tapdata
TAPDATA_IMAGE=ghcr.io/tapdata/tapdata:latest
TAPDATA_UI_PORT=3030
TAPDATA_API_PORT=3080
AI_PANEL_PORT=3000
MONGO_PORT=27017

# Local demo MongoDB. One MongoDB server hosts separate source/FDM/MDM/target
# databases so the kit stays small while TapData still demonstrates CDC and
# transformations between logical layers.
MONGO_ROOT_USER=demo_admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=marketing_demo
SOURCE_MONGO_DB=tapdata_casino_marketing
FDM_MONGO_DB=marketing_fdm
MDM_MONGO_DB=marketing_mdm

# Optional external TapData metadata Mongo connection. The official community
# image uses an embedded metadata Mongo by default; leave this empty unless
# your TapData edition documents an external metadata URI.
TAPDATA_MONGO_URI=
TAPDATA_EXPORT_ROOT=./deploy/tapdata/exports

# AI panel: all values are injected server-side into the container.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Published TapData APIs. For a fully local TapData instance the defaults are
# container-to-container URLs; replace them with your published MDM gateway
# when using an external/managed TapData deployment.
TAPDATA_API_BASE_URL=http://tapdata:3080
TAPDATA_FIND_PATH_TEMPLATE=/api/v1/{collection}/find
TAPDATA_TOKEN_URL=http://tapdata:3030/oauth/token
TAPDATA_CLIENT_ID=
TAPDATA_CLIENT_SECRET=
TAPDATA_TOKEN_AUTH_METHOD=client_secret_post
TAPDATA_ACCESS_TOKEN=
TAPDATA_COLLECTION_MAP=
# Optional automatic OAuth discovery from TapData's tapdata.Application
# collection. The default filter selects the Data Explorer application.
# For an external TapData deployment, use a metadata URI reachable from this
# container. Otherwise the helper falls back to TAPDATA_MONGO_URI above.
TAPDATA_METADATA_URI=
TAPDATA_METADATA_DB=tapdata
TAPDATA_METADATA_COLLECTION=Application
TAPDATA_METADATA_FILTER_JSON={"name":"Data Explorer"}
TAPDATA_METADATA_CLIENT_ID_PATH=clientId
TAPDATA_METADATA_CLIENT_SECRET_PATH=clientSecret
TAPDATA_METADATA_CACHE_TTL_MS=300000
TAPDATA_METADATA_TIMEOUT_MS=3000
TAPDATA_STORE_CREDENTIALS=false
TAPDATA_PAGE_SIZE=200
TAPDATA_REQUEST_TIMEOUT_MS=8000
TAPDATA_BODY_TIMEOUT_MS=8000
TAPDATA_SCAN_LIMIT=1000

# Optional TapData export importer. The TapData web UI Import flow remains the
# default and safest path. The CLI wrapper is fail-closed: it never guesses a
# private endpoint. Set exact paths/body fields only after confirming them in
# your TapData edition. Files are mounted read-only into the importer.
TAPDATA_IMPORT_MODE=manual
TAPDATA_IMPORT_ROOT=./deploy/tapdata/exports
TAPDATA_CONNECTION_EXPORT=
TAPDATA_TASK_EXPORT=
TAPDATA_SOURCE_MONGODB_URI=
TAPDATA_CONNECTION_IMPORT_PATH=
TAPDATA_TASK_IMPORT_PATH=
TAPDATA_IMPORT_URI_FIELD=
TAPDATA_IMPORT_TOKEN=
TAPDATA_IMPORT_CONNECTION_FORM_FIELDS_JSON=
TAPDATA_IMPORT_TASK_FORM_FIELDS_JSON=
TAPDATA_IMPORT_FORM_FIELDS_JSON=
TAPDATA_CONNECTION_LIST_PATH=
TAPDATA_TASK_START_PATH=
TAPDATA_TASK_START_METHOD=POST
TAPDATA_TASK_START_BODY_JSON=
TAPDATA_IMPORT_AUTOSTART=false
TAPDATA_IMPORT_TIMEOUT_MS=15000
TAPDATA_IMPORT_ALLOW_MISSING_URI=false
TAPDATA_IMPORT_STATE_DIR=./runtime/tapdata-import
TAPDATA_IMPORT_CONNECTION_FILE_FIELD=connectionFile
TAPDATA_IMPORT_TASK_FILE_FIELD=taskFile

# Mongo-backed persistence used by the AI panel (audit/demo journey and an
# optional local snapshot fallback). The app itself owns collection creation.
MONGO_AUDIT_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongo:27017/${MONGO_DATABASE}?authSource=admin
MONGO_AUDIT_DB=${MONGO_DATABASE}
MONGO_AUDIT_COLLECTION=ai_action_events
MONGO_SNAPSHOT_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongo:27017/${MONGO_DATABASE}?authSource=admin
MONGO_SNAPSHOT_DB=${MONGO_DATABASE}
MONGO_SNAPSHOT_COLLECTION=live_patrons_snapshot
MONGO_DEMO_JOURNEY_COLLECTION=demo_upgrade_journeys
MONGO_BOOTSTRAP_COLLECTION=tapdata_runtime_config

# Restored-source feeder: updates existing profiles/sessions in this database.
# Keep writes disabled until the user approves a data test.
SOURCE_MONGO_URI=
FEEDER_WRITE_ENABLED=false
FEEDER_INTERVAL_MS=15000
FEEDER_DURATION_HOURS=0
FEEDER_SESSION_UPDATES_PER_TICK=1
FEEDER_BET_INCREMENT=500
