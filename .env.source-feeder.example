# Real-time source feeder configuration.
# Copy to `.env.source-feeder` and fill the values. Do not commit real secrets.

# Feeder behavior
FEEDER_INTERVAL_MS=3000
FEEDER_START_PLAYER_ID=105000
FEEDER_SCENARIO=mixed
FEEDER_ALLOW_PARTIAL=false
FEEDER_DURATION_HOURS=0
FEEDER_BATCH_SIZE=5
# Safety guardrails: active customers never exceed 350 and visible table population never exceeds 25.
FEEDER_MAX_ACTIVE_PATRONS=350
FEEDER_ACTIVE_PATRON_LIMIT=220
FEEDER_POOL_SIZE=350
FEEDER_MAX_TABLE_VISIBLE=25
FEEDER_RISK_RATIO=0.02
FEEDER_RETIRE_PLAYER_RANGE=

# Oracle Gaming Core
ORACLE_USER=<oracle-user>
ORACLE_PASSWORD=<oracle-password>
ORACLE_CONNECT_STRING=<oracle-host>:1521/orcl
ORACLE_SCHEMA=C##GAMING

# MSSQL Hotel / Ops
MSSQL_SERVER=<mssql-host>
MSSQL_PORT=1433
MSSQL_DATABASE=casino_ops
MSSQL_USER=<mssql-user>
MSSQL_PASSWORD=<mssql-password>
MSSQL_SCHEMA=dbo
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# PostgreSQL Loyalty / CRM
PGHOST=<postgres-host>
PGPORT=5432
PGDATABASE=postgres
PGUSER=<postgres-user>
PGPASSWORD=<postgres-password>
PGSCHEMA=casino_loyalty
PGSSL=false
